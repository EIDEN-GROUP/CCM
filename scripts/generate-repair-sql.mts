/**
 * Generate `supabase/repair.sql`.
 *
 * The file is a complete, idempotent rebuild of CCM's authorisation layer:
 * the alert tables, the Row Level Security helper functions, every policy,
 * and the seed data. It is generated from `src/domain/seed.ts` so it cannot
 * drift from the application.
 *
 *   npx tsx scripts/generate-repair-sql.mts
 *
 * Apply it with one of:
 *   - the Supabase dashboard's SQL editor (paste and run), or
 *   - `psql "$DATABASE_URL" -f supabase/repair.sql`, or
 *   - `npx tsx scripts/apply-repair.mts` when a management token is available.
 */
import { writeFileSync } from "node:fs";
import {
  METRIC_SEED,
  PROVIDER_SEED,
  REPORT_SEED,
  ROLE_PERMISSION_SEED,
  ROLE_SEED,
  ROLE_TAB_ACCESS_SEED,
} from "../src/domain/seed";
import { syncJobKindSql } from "../src/lib/jobs/kinds";

/** Escape a value for a single-quoted SQL string. */
function sql(value: unknown): string {
  if (value === null || value === undefined) return "null";
  if (typeof value === "number") return String(value);
  if (typeof value === "boolean") return value ? "true" : "false";
  return `'${String(value).replace(/'/g, "''")}'`;
}

function sqlArray(values: readonly string[]): string {
  // The explicit cast matters for an empty array: `array[]` has no elements
  // for Postgres to infer a type from.
  return `array[${values.map(sql).join(", ")}]::text[]`;
}

/**
 * A `text[]` literal.
 *
 * It uses the `ARRAY[...]` constructor, never the bare `{...}` form. The
 * brace form is only accepted in a "value context"; inside a `VALUES` row
 * each element is parsed as an expression, and there the brace form is a
 * syntax error:
 *
 *   insert into t (arr) values ('{"a","b"}');   -- works (a string)
 *   insert into t (arr) values ({"a","b"});     -- ERROR: syntax error at "{"
 *   insert into t (arr) values (array['a','b']); -- works
 *
 * The cast is explicit because an **empty** array has no elements for
 * Postgres to infer a type from, and `array[]` alone is an error.
 */
function textArray(values: readonly string[]): string {
  return `array[${values.map(sql).join(", ")}]::text[]`;
}

/** A JSON array literal, for a `jsonb` column. */
function jsonArrayLiteral(values: readonly string[]): string {
  return `'${JSON.stringify(values).replace(/'/g, "''")}'`;
}

/** A JSON array literal, for a `jsonb` column. */
function jsonArray(values: readonly string[]): string {
  return `'${JSON.stringify(values).replace(/'/g, "''")}'::jsonb`;
}

const out: string[] = [];

out.push(`-- ============================================================================
-- CCM — authorisation repair.
--
-- Generated by scripts/generate-repair-sql.mts. Do not edit by hand.
--
-- This rebuilds the Row Level Security layer and the seed data. It is
-- idempotent: running it twice is safe, and running it against a database
-- that is already correct changes nothing.
--
-- It fixes:
--   * the alert tables, if migration 0006 was never applied;
--   * the RLS helper functions, if migration 0009 aborted;
--   * any policy that is missing or out of date;
--   * the seed data (roles, the permission matrix, the provider catalogue and
--     the metric registry).
--
-- Apply with the Supabase SQL editor, with psql, or with
-- scripts/apply-repair.mts.
-- ============================================================================

begin;

-- --- The alert queue ---------------------------------------------------------

create table if not exists public.alert_rules (
  id                uuid primary key default gen_random_uuid(),
  workspace_id      uuid not null references public.workspaces(id) on delete cascade,
  metric            text not null,
  direction         text not null check (direction in ('increase', 'decrease')),
  threshold         numeric not null,
  severity          text not null default 'warning',
  min_volume        numeric not null default 0,
  hysteresis_windows integer not null default 2,
  grace_windows     integer not null default 7,
  quiet_hours       jsonb,
  min_repeat_hours  integer not null default 24,
  scope             jsonb,
  enabled           boolean not null default true,
  created_by        uuid references auth.users(id) on delete set null,
  created_at        timestamptz not null default now(),
  updated_at        timestamptz not null default now()
);

create table if not exists public.alerts (
  id             uuid primary key default gen_random_uuid(),
  workspace_id   uuid not null references public.workspaces(id) on delete cascade,
  rule_id        uuid references public.alert_rules(id) on delete set null,
  account_id     uuid references public.external_accounts(id) on delete cascade,
  website_id     uuid references public.websites(id) on delete cascade,
  metric         text not null,
  severity       text not null default 'warning',
  title          text not null,
  reason         text not null,
  observed       numeric,
  baseline       numeric,
  confidence     numeric,
  status         text not null default 'open'
                   check (status in ('open','acknowledged','snoozed','resolved')),
  owner_user_id  uuid references auth.users(id) on delete set null,
  due_at         timestamptz,
  source_ref     jsonb not null default '{}'::jsonb,
  opened_at      timestamptz not null default now(),
  resolved_at    timestamptz,
  resolution_note text
);

create table if not exists public.action_items (
  id             uuid primary key default gen_random_uuid(),
  workspace_id   uuid not null references public.workspaces(id) on delete cascade,
  alert_id       uuid references public.alerts(id) on delete set null,
  title          text not null,
  detail         text,
  status         text not null default 'open'
                   check (status in ('open','in_progress','done','cancelled')),
  priority       text not null default 'normal'
                   check (priority in ('low','normal','high')),
  owner_user_id  uuid references auth.users(id) on delete set null,
  due_at         timestamptz,
  source         text not null default 'manual',
  created_at     timestamptz not null default now(),
  updated_at     timestamptz not null default now()
);

create table if not exists public.action_item_events (
  id             uuid primary key default gen_random_uuid(),
  action_item_id uuid not null references public.action_items(id) on delete cascade,
  actor_user_id  uuid references auth.users(id) on delete set null,
  event_type     text not null,
  note           text,
  created_at     timestamptz not null default now()
);

create index if not exists alert_rules_workspace_idx
  on public.alert_rules (workspace_id, enabled);
create index if not exists alerts_workspace_status_idx
  on public.alerts (workspace_id, status, severity, opened_at desc);
create index if not exists action_items_workspace_idx
  on public.action_items (workspace_id, status, created_at desc);
create index if not exists action_item_events_item_idx
  on public.action_item_events (action_item_id, created_at desc);

-- The scheduled digests. A report definition belongs to a workspace, so the
-- seed below creates one of each for every workspace.

create table if not exists public.report_definitions (
  id          uuid primary key default gen_random_uuid(),
  workspace_id uuid not null references public.workspaces(id) on delete cascade,
  key         text not null,
  title       text not null,
  description text,
  cadence     text not null default 'on_demand'
                check (cadence in ('daily','weekly','monthly','on_demand')),
  sections    jsonb not null default '[]'::jsonb,
  formats     text[] not null default '{csv}',
  recipients  text[] not null default '{}',
  created_by  uuid references auth.users(id) on delete set null,
  enabled     boolean not null default true,
  last_run_at timestamptz,
  next_run_at timestamptz,
  created_at  timestamptz not null default now(),
  updated_at  timestamptz not null default now(),
  unique (workspace_id, key)
);

create table if not exists public.report_runs (
  id            uuid primary key default gen_random_uuid(),
  workspace_id  uuid not null references public.workspaces(id) on delete cascade,
  definition_id uuid references public.report_definitions(id) on delete set null,
  period_start  date,
  period_end    date,
  timezone      text,
  currency      text,
  status        text not null default 'pending',
  payload       jsonb not null default '{}'::jsonb,
  safe_mode     boolean not null default true,
  generated_at  timestamptz not null default now()
);

create index if not exists report_definitions_workspace_idx
  on public.report_definitions (workspace_id, enabled);
create index if not exists report_runs_workspace_idx
  on public.report_runs (workspace_id, generated_at desc);

-- The provider apps. The client id and the client secret of a provider's
-- app, entered in the interface and encrypted before they are stored.

create table if not exists public.provider_app_credentials (
  id               uuid primary key default gen_random_uuid(),
  workspace_id     uuid not null references public.workspaces(id) on delete cascade,
  provider_key     text not null references public.provider_definitions(key) on delete cascade,
  client_id        text not null,
  encrypted_secret text,
  key_fingerprint  text,
  redirect_uri     text,
  scopes           text[] not null default '{}'::text[],
  notes            text,
  created_by       uuid references auth.users(id) on delete set null,
  created_at       timestamptz not null default now(),
  updated_at       timestamptz not null default now(),
  unique (workspace_id, provider_key)
);

create index if not exists provider_app_credentials_workspace_idx
  on public.provider_app_credentials (workspace_id, provider_key);

-- The per-role tab access. The levels are the input; the feature
-- permissions the database enforces are derived from them.

create table if not exists public.role_tab_access (
  workspace_id uuid not null references public.workspaces(id) on delete cascade,
  role text not null references public.roles(key) on delete cascade,
  tab text not null,
  level text not null check (level in ('none','view','use','edit')),
  updated_by uuid references auth.users(id) on delete set null,
  updated_at timestamptz not null default now(),
  primary key (workspace_id, role, tab)
);

create index if not exists role_tab_access_role_idx
  on public.role_tab_access (role);

-- The role grants are per workspace, so one workspace's owner can never
-- change what a role means in another workspace.

alter table public.role_permissions
  add column if not exists workspace_id uuid
  references public.workspaces(id) on delete cascade;

update public.role_permissions
   set workspace_id = w.id
  from public.workspaces w
 where role_permissions.workspace_id is null;

delete from public.role_permissions where workspace_id is null;

alter table public.role_permissions
  drop constraint if exists role_permissions_pkey;
alter table public.role_permissions
  add primary key (workspace_id, role, permission);

create index if not exists role_permissions_role_idx
  on public.role_permissions (role);

-- --- Row Level Security helper functions -------------------------------------
--
-- SECURITY DEFINER with a pinned search_path. A policy that read
-- workspace_members through RLS would recurse, so the helpers do the
-- authorisation themselves and re-check auth.uid() every time.

create or replace function public.is_workspace_member(target_workspace uuid)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1
    from public.workspace_members m
    where m.workspace_id = target_workspace
      and m.user_id = auth.uid()
      and m.status = 'active'
  );
$$;

create or replace function public.has_permission(target_workspace uuid, perm text)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1
    from public.workspace_members m
    join public.role_permissions rp
      on rp.workspace_id = m.workspace_id
     and rp.role = m.role
    where m.workspace_id = target_workspace
      and m.user_id = auth.uid()
      and m.status = 'active'
      and rp.permission = perm
  );
$$;

create or replace function public.can_access_account(target_account uuid, perm text)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1
    from public.external_accounts a
    join public.workspace_members m
      on m.workspace_id = a.workspace_id
     and m.user_id = auth.uid()
     and m.status = 'active'
    join public.roles r
      on r.key = m.role
    join public.role_permissions rp
      on rp.workspace_id = m.workspace_id
     and rp.role = m.role
     and rp.permission = perm
    where a.id = target_account
      and (
        r.account_scoped = false
        or exists (
          select 1
          from public.external_account_grants g
          where g.external_account_id = a.id
            and g.user_id = auth.uid()
            and g.permission = perm
        )
      )
  );
$$;

create or replace function public.can_read_account(target_account uuid)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  -- An account row is visible when the user can reach it by *any* route:
  --
  --   * a workspace-wide role reaches it with the catalogue permission;
  --   * an account-scoped role reaches exactly the accounts it was granted,
  --     whatever permission the grant carries.
  --
  -- The second route is why this is separate from can_access_account: a
  -- mailbox user holds the inbox read permission and has been granted one
  -- account, and must be able to read that account row without also holding
  -- the workspace-wide integrations permission.
  select exists (
    select 1
    from public.external_accounts a
    join public.workspace_members m
      on m.workspace_id = a.workspace_id
     and m.user_id = auth.uid()
     and m.status = 'active'
    join public.roles r
      on r.key = m.role
    where a.id = target_account
      and (
        (
          r.account_scoped = false
          and exists (
            select 1
            from public.role_permissions rp
            where rp.role = m.role
              and rp.permission = 'integrations.read'
          )
        )
        or exists (
          select 1
          from public.external_account_grants g
          where g.external_account_id = a.id
            and g.user_id = auth.uid()
        )
      )
  );
$$;

create or replace function public.can_read_metric(
  target_workspace uuid,
  target_account uuid,
  perm text
)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select public.has_permission(target_workspace, perm)
     and public.can_access_account(target_account, perm);
$$;

create or replace function public.metric_permission(metric_key text)
returns text
language sql
immutable
as $$
  select case
    when metric_key like 'ads.%'    then 'ads.read'
    when metric_key like 'ga4.%'    then 'analytics.read'
    when metric_key like 'gsc.%'    then 'seo.read'
    when metric_key like 'social.%' then 'social.read'
    when metric_key like 'gtm.%'    then 'gtm.read'
    when metric_key like 'ux.%'     then 'ux.read'
    else 'overview.read'
  end;
$$;

grant execute on function public.is_workspace_member(uuid) to authenticated;
grant execute on function public.has_permission(uuid, text) to authenticated;
grant execute on function public.can_access_account(uuid, text) to authenticated;
grant execute on function public.can_read_account(uuid) to authenticated;
grant execute on function public.can_read_metric(uuid, uuid, text) to authenticated;
grant execute on function public.metric_permission(text) to authenticated;

-- --- Provider quota accounting ------------------------------------------------
--
-- A provider that has an operations quota needs the usage recorded, or the
-- quota cannot be respected before the provider rejects a call. The counter
-- is incremented atomically so two workers cannot lose an update.

create or replace function public.add_provider_quota_usage(
  p_connection_id uuid,
  p_calls        integer,
  p_window_start timestamptz default null
)
returns integer
language plpgsql
security definer
set search_path = public
as $$
declare
  v_used integer;
begin
  update public.provider_connections
     set quota_used = case
                         when p_window_start is not null
                          and quota_window_started_at is distinct from p_window_start
                           then p_calls
                         else quota_used + p_calls
                       end,
         quota_window_started_at = coalesce(p_window_start, quota_window_started_at),
         updated_at = now()
   where id = p_connection_id
   returning quota_used into v_used;

  return coalesce(v_used, 0);
end;
$$;

revoke all on function public.add_provider_quota_usage(uuid, integer, timestamptz) from public;
grant execute on function public.add_provider_quota_usage(uuid, integer, timestamptz) to service_role;

create or replace function public.has_provider_quota(p_connection_id uuid)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select coalesce(
    (
      select quota_limit is null or quota_used < quota_limit
        from public.provider_connections
       where id = p_connection_id
    ),
    true
  );
$$;

revoke all on function public.has_provider_quota(uuid) from public;
grant execute on function public.has_provider_quota(uuid) to service_role;

-- --- Seed data: the per-role tab access ---------------------------------------
--
-- The levels the owner sees and edits. The permission set is derived from
-- them, so the two cannot disagree.

insert into public.role_tab_access (workspace_id, role, tab, level)
select w.id, r.role, r.tab, r.level
from public.workspaces w
cross join (
  values
${Object.entries(ROLE_TAB_ACCESS_SEED)
  .flatMap(([role, levels]) =>
    Object.entries(levels).map(
      ([tab, level]) => `    (${sql(role)}, ${sql(tab)}, ${sql(level)})`,
    ),
  )
  .join(",\n")}
  ) as r(role, tab, level)
on conflict (workspace_id, role, tab) do update
  set level = excluded.level,
      updated_at = now();

-- --- Seed data: the role matrix ---------------------------------------------

insert into public.roles (key, label, account_scoped, description) values
${ROLE_SEED.map(
  (role) =>
    `  (${sql(role.key)}, ${sql(role.label)}, ${role.account_scoped}, ${sql(role.description)})`,
).join(",\n")}
on conflict (key) do update
  set label = excluded.label,
      account_scoped = excluded.account_scoped,
      description = excluded.description;

-- The grants are per workspace: every workspace gets the default matrix,
-- and an owner may then change their own workspace's roles without touching
-- anybody else's.

insert into public.role_permissions (workspace_id, role, permission)
select w.id, r.role, r.permission
from public.workspaces w
cross join (
  values
${Object.entries(ROLE_PERMISSION_SEED)
  .flatMap(([role, permissions]) =>
    permissions.map(
      (permission) => `    (${sql(role)}, ${sql(permission)})`,
    ),
  )
  .join(",\n")}
  ) as r(role, permission)
on conflict (workspace_id, role, permission) do nothing;

-- --- A new workspace gets its defaults ----------------------------------------
--
-- The grants, the tab levels and the digests belong to a workspace, so a
-- workspace created after the repair would otherwise have none. A trigger
-- seeds them at the moment the workspace is created.

create or replace function public.seed_workspace_defaults()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.role_permissions (workspace_id, role, permission)
  select new.id, r.role, r.permission
  from (
    values
${Object.entries(ROLE_PERMISSION_SEED)
  .flatMap(([role, permissions]) =>
    permissions.map(
      (permission) => `      (${sql(role)}, ${sql(permission)})`,
    ),
  )
  .join(",\n")}
  ) as r(role, permission)
  on conflict (workspace_id, role, permission) do nothing;

  insert into public.role_tab_access (workspace_id, role, tab, level)
  select new.id, r.role, r.tab, r.level
  from (
    values
${Object.entries(ROLE_TAB_ACCESS_SEED)
  .flatMap(([role, levels]) =>
    Object.entries(levels).map(
      ([tab, level]) => `      (${sql(role)}, ${sql(tab)}, ${sql(level)})`,
    ),
  )
  .join(",\n")}
  ) as r(role, tab, level)
  on conflict (workspace_id, role, tab) do nothing;

  insert into public.report_definitions
    (workspace_id, key, title, description, cadence, sections, formats, recipients, enabled)
  select new.id, r.key, r.title, r.description, r.cadence, r.sections, r.formats, '{}'::text[], r.enabled
  from (
    values
${REPORT_SEED.map(
  (report) =>
    `      (${sql(report.key)}, ${sql(report.title)}, ${sql(report.description)}, ${sql(report.cadence)}, ${jsonArrayLiteral(report.sections)}::jsonb, ${textArray(report.formats)}, ${report.enabled})`,
).join(",\n")}
  ) as r(key, title, description, cadence, sections, formats, enabled)
  on conflict (workspace_id, key) do nothing;

  return new;
end;
$$;

drop trigger if exists seed_workspace_defaults on public.workspaces;

create trigger seed_workspace_defaults
  after insert on public.workspaces
  for each row execute function public.seed_workspace_defaults();

-- --- Seed data: the provider catalogue ---------------------------------------

insert into public.provider_definitions
  (key, display_name, category, api_version, hosts, docs_url, blocking_approvals)
values
${PROVIDER_SEED.map(
  (provider) =>
    `  (${sql(provider.key)}, ${sql(provider.display_name)}, ${sql(provider.category)}, ${sql(
      provider.api_version,
    )}, ${textArray(provider.hosts)}, ${sql(provider.docs_url)}, ${sqlArray(
      provider.blocking_approvals,
    )})`,
).join(",\n")}
on conflict (key) do update
  set display_name = excluded.display_name,
      category = excluded.category,
      api_version = excluded.api_version,
      hosts = excluded.hosts,
      docs_url = excluded.docs_url,
      blocking_approvals = excluded.blocking_approvals,
      updated_at = now();

-- --- Seed data: the metric registry ------------------------------------------

insert into public.metric_definitions
  (key, display_name, definition, formula, connector, source_field, unit, grain,
   currency_aware, aggregation, dimensions, attribution_notes, caveats, freshness_target_seconds)
values
${METRIC_SEED.map(
  (metric) =>
    `  (${sql(metric.key)}, ${sql(metric.display_name)}, ${sql(metric.definition)}, ${sql(
      metric.formula,
    )}, ${sql(metric.connector)}, ${sql(metric.source_field)}, ${sql(metric.unit)}, ${sql(
      metric.grain,
    )}, ${metric.currency_aware}, ${sql(metric.aggregation)}, ${textArray(
      metric.dimensions,
    )}, ${sql(metric.attribution_notes)}, ${sqlArray(
      metric.caveats,
    )}, ${metric.freshness_target_seconds})`,
).join(",\n")}
on conflict (key) do update
  set display_name = excluded.display_name,
      definition = excluded.definition,
      formula = excluded.formula,
      connector = excluded.connector,
      source_field = excluded.source_field,
      unit = excluded.unit,
      grain = excluded.grain,
      currency_aware = excluded.currency_aware,
      aggregation = excluded.aggregation,
      dimensions = excluded.dimensions,
      attribution_notes = excluded.attribution_notes,
      caveats = excluded.caveats,
      freshness_target_seconds = excluded.freshness_target_seconds,
      updated_at = now();

-- --- Seed data: the scheduled digests ----------------------------------------
--
-- A digest definition belongs to a workspace, so one of each is created for
-- every workspace that already exists. The recipients are left empty: who
-- receives a digest is a decision the owner makes, not a default.

insert into public.report_definitions
  (workspace_id, key, title, description, cadence, sections, formats, recipients, enabled)
select
  w.id,
  s.key,
  s.title,
  s.description,
  s.cadence,
  s.sections,
  s.formats,
  '{}'::text[],
  s.enabled
from public.workspaces w
cross join (
  values
${REPORT_SEED.map(
  (report) =>
    `    (${sql(report.key)}, ${sql(report.title)}, ${sql(
      report.description,
    )}, ${sql(report.cadence)}, ${jsonArray(
      report.sections,
    )}::jsonb, ${textArray(report.formats)}, ${report.enabled})`,
).join(",\n")}
) as s(key, title, description, cadence, sections, formats, enabled)
on conflict (workspace_id, key) do update
  set title = excluded.title,
      description = excluded.description,
      cadence = excluded.cadence,
      sections = excluded.sections,
      formats = excluded.formats,
      updated_at = now();
`);

// --- Row Level Security policies ---------------------------------------------

out.push(`-- --- Row Level Security policies ---------------------------------------------

-- Every table is protected. The helper functions decide what each role may
-- read, and the account-scoped roles additionally need an explicit grant.
`);

interface Policy {
  table: string;
  name: string;
  command: "select" | "all" | "insert" | "update" | "delete";
  using?: string;
  check?: string;
}

const POLICIES: Policy[] = [
  { table: "roles", name: "roles_read", command: "select", using: "true" },
  { table: "role_permissions", name: "role_permissions_read", command: "select", using: "true" },

  { table: "workspaces", name: "workspaces_read", command: "select", using: "public.is_workspace_member(id)" },
  { table: "workspaces", name: "workspaces_update", command: "update", using: "public.has_permission(id, 'settings.manage')", check: "public.has_permission(id, 'settings.manage')" },

  { table: "workspace_members", name: "workspace_members_read", command: "select", using: "public.is_workspace_member(workspace_id)" },
  { table: "workspace_members", name: "workspace_members_insert", command: "insert", check: "public.has_permission(workspace_id, 'settings.manage')" },
