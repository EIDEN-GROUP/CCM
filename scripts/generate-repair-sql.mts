out.push(`
-- --- The job-kind enum ------------------------------------------------------
--
-- The application enqueues job kinds the enum must have. It is recreated
-- when a kind is missing, and only then: \`ALTER TYPE ... ADD VALUE\` cannot
-- be run inside a function and cannot be undone, so the column is moved to
-- text, the type is replaced, and the column is moved back.
--
-- The list comes from src/lib/jobs/kinds.ts, which is the same list the
-- handler registry uses.

do $$
declare
  v_missing text;
begin
  select string_agg(e.enumlabel, ', ')
    into v_missing
  from pg_type t
  join pg_enum e on e.enumtypid = t.oid
  where t.typname = 'sync_job_kind'
    and t.typnamespace = 'public'::regnamespace
    and e.enumlabel not in (${syncJobKindSql()});

  if v_missing is not null then
    alter table public.sync_jobs alter column kind type text;
    drop type if exists public.sync_job_kind;
    create type public.sync_job_kind as enum (${syncJobKindSql()});
    alter table public.sync_jobs
      alter column kind type public.sync_job_kind
      using kind::public.sync_job_kind;
  end if;
end
$$;
`);

const allTables = [
  ...new Set(POLICIES.map((policy) => policy.table)),
  "provider_connection_credentials",
];

for (const table of allTables) {
  out.push(`alter table public.${table} enable row level security;`);
}

out.push("");

for (const policy of POLICIES) {
  out.push(`drop policy if exists ${policy.name} on public.${policy.table};`);
  const parts = [`create policy ${policy.name} on public.${policy.table}`, `for ${policy.command}`, `to authenticated`];
  if (policy.using) parts.push(`using (${policy.using})`);
  if (policy.check) parts.push(`with check (${policy.check})`);
  out.push(`${parts.join(" ")};`);
}

out.push(`
-- --- Table privileges --------------------------------------------------------
--
-- The policies above decide *which rows* the authenticated role may see.
-- These grants give it the *table* privileges the policies need. They are
-- derived from the policy list, so a table with no policy for a command
-- gets no privilege for it.
--
-- provider_connection_credentials is deliberately absent: it has a policy
-- that denies every authenticated role, and no privilege is granted either.
-- Only the service role — the sync worker — may read it.
`);

out.push("grant usage on schema public to authenticated;");

const grantable = new Map<string, Set<string>>();

for (const policy of POLICIES) {
  const commands =
    policy.command === "all"
      ? ["select", "insert", "update", "delete"]
      : [policy.command];

  const set = grantable.get(policy.table) ?? new Set<string>();
  for (const command of commands) set.add(command);
  grantable.set(policy.table, set);
}

for (const [table, commands] of [...grantable.entries()].sort()) {
  // A policy that denies everything still needs the privilege for the
  // denial to be the thing that stops the read, not a privilege error.
  for (const command of commands) {
    out.push(`grant ${command} on public.${table} to authenticated;`);
  }
}

out.push(`
-- Tell PostgREST to reload its schema cache, so the new functions and
-- policies are picked up immediately rather than at the next cache expiry.
notify pgrst, 'reload schema';

commit;
`);

const output = out.join("\n");
writeFileSync("supabase/repair.sql", output, "utf8");

console.log(
  `supabase/repair.sql written (${output.length} characters, ${POLICIES.length} policies, ${allTables.length} tables protected).`,
);
