# =============================================================================
# CCM — Command Center Management
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `.env.local` is gitignored. Only variable NAMES live here.
# =============================================================================

# --- Application ------------------------------------------------------------
# Public origin of the deployed app. Used for OAuth callback construction and
# as the allowlisted origin for the browser bridge extension.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Cloud project (production) or local stack (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only. Never expose to the browser, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by migrations and the RLS test harness.
DATABASE_URL=

# --- Application encryption -------------------------------------------------
# 32-byte key, base64 encoded, used for authenticated encryption of provider
# refresh tokens at rest. Kept separate from the database. Rotate via
# docs/SECURITY.md -> "Token encryption key rotation".
APP_ENCRYPTION_KEY=

# --- Launch ticket signing (account launcher) --------------------------------
# Ed25519 private key (PKCS#8 PEM or base64url JWK). Signs short-lived launch
# tickets. The browser bridge extension only ever receives the PUBLIC key.
LAUNCH_SIGNING_PRIVATE_KEY=
LAUNCH_SIGNING_PUBLIC_KEY=
LAUNCH_SIGNING_KEY_ID=ccm-launch-1

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token required by /api/jobs/* dispatch endpoints.
CRON_SECRET=

# --- Google Cloud (one project serves GA4, GSC, GTM, Ads, YouTube, Gmail) ---
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: override the default derived callback URL.
GOOGLE_OAUTH_REDIRECT_URI=

# Post-2026-09-09 access model: access level now lives on the Google Cloud
# project, NOT on a developer token. Record the granted level for display only.
GOOGLE_ADS_API_ACCESS_LEVEL=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=

# --- Google sub-products ----------------------------------------------------
GA4_PROPERTY_ID=
# Optional: discovered from the GTM container when absent.
GA4_MEASUREMENT_ID=
# Search Console property: full URL or the sc-domain: form.
GSC_PROPERTY_URL=https://www.medicalbay.ma/
GTM_CONTAINER_ID=
YOUTUBE_CHANNEL_ID=

# --- Microsoft Clarity (UX) -------------------------------------------------
CLARITY_PROJECT_ID=
# Only set if the official API/export surface issues a token for your plan.
CLARITY_API_TOKEN=

# --- Meta / Instagram / Facebook -------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=

# --- LinkedIn ---------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_ID=
LINKEDIN_PAGE_ID=

# --- Rank tracking (primary provider: Ahrefs) ------------------------------
AHREFS_API_KEY=
AHREFS_RANK_TRACKER_PROJECT_ID=

# --- Browser bridge extension ----------------------------------------------
# The bridge id is pinned by manifest.key and the app bridge configuration.
# Shared secret binding the extension instance to this deployment.
BRIDGE_PAIRING_SECRET=

# --- AI analyst -------------------------------------------------------------
# Model provider used for grounded answers. Optional: the AI surface reports
# "not configured" when unset rather than fabricating answers.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- Site health checks -----------------------------------------------------
PAGESPEED_API_KEY=
UPTIME_MONITOR_TOKEN=
# --- The public origin -------------------------------------------------------
# The URL this deployment is reached at. The Provider apps screen shows the
# redirect URI to register with each provider, and it is built from this.
# Optional: the screen falls back to the path only.
NEXT_PUBLIC_APP_ORIGIN=https://ccm.medicalbay.ma
