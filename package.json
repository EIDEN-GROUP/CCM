{
  "name": "ccm",
  "version": "0.1.0",
  "private": true,
  "description": "CCM - Command Center Management. Marketing and business operations command center for Medical Bay (Agadir, Morocco).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:test": "vitest run tests/rls",
    "keys:launch": "tsx scripts/generate-launch-keys.mts",
    "admin:create": "tsx scripts/create-admin.mts",
    "db:seed": "tsx scripts/seed-database.mts",
    "db:repair:generate": "tsx scripts/generate-repair-sql.mts",
    "db:repair:apply": "tsx scripts/apply-repair.mts",
    "db:repair:apply:direct": "tsx scripts/apply-repair-direct.mts",
    "db:validate": "tsx scripts/validate-repair.mts",
    "db:inspect": "tsx scripts/inspect-supabase.mts",
    "doctor": "tsx scripts/doctor.mts",
    "check:links": "tsx scripts/check-links.mts",
    "worker": "tsx scripts/worker.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "imapflow": "^2.9.1",
    "jose": "6.2.13",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "postal-mime": "^4.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
