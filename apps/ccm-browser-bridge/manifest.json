{
  "manifest_version": 3,
  "name": "CCM Browser Bridge",
  "version": "0.2.0",
  "description": "Opens CCM's connected accounts in the browser profile where this extension is installed, and verifies that the request really came from CCM.",
  "minimum_chrome_version": "116",
  "key": "",

  "permissions": ["storage", "scripting"],

  "host_permissions": [
    "http://localhost:3000/*",
    "https://ccm.medicalbay.ma/*",
    "https://ccm.eiden-group.com/*",
    "https://accounts.google.com/*",
    "https://www.facebook.com/*",
    "https://business.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://www.linkedin.com/*",
    "https://app.ahrefs.com/*",
    "https://clarity.microsoft.com/*",
    "https://login.microsoftonline.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://ccm.medicalbay.ma/*",
      "https://ccm.eiden-group.com/*"
    ]
  },

  "options_page": "options.html",

  "action": {
    "default_title": "CCM Browser Bridge",
    "default_popup": "popup.html"
  }
}
